# Configuration d'environnement pour Synq Chat
# Copiez ce fichier vers .env.local et configurez vos paramètres

# Configuration de base Rocket.Chat
MONGO_URL=mongodb://localhost:27017/synq
ROOT_URL=http://localhost:3000
PORT=3000

# Configuration Synq - Interface Utilisateur
SYNQ_UX_SIMPLIFIED_ENABLED=true
SYNQ_UX_ONBOARDING_ENABLED=true
SYNQ_UX_GUIDED_TOURS_ENABLED=true
SYNQ_UX_CONTEXTUAL_TIPS_ENABLED=true
SYNQ_UX_HELP_CENTER_ENABLED=true

# Configuration Synq - Branding
SYNQ_WORKSPACE_NAME=Synq
SYNQ_PRIMARY_COLOR=#1d74f5
SYNQ_SECONDARY_COLOR=#f5455c
SYNQ_ACCENT_COLOR=#ffd21f
SYNQ_BACKGROUND_COLOR=#ffffff
SYNQ_TEXT_COLOR=#2f343d
SYNQ_LOGIN_WELCOME_TEXT=Bienvenue sur Synq
SYNQ_LOGIN_SUBTITLE_TEXT=Votre plateforme de communication souveraine

# Configuration Synq - Permissions
SYNQ_PERMISSIONS_GRANULAR_ENABLED=true
SYNQ_PERMISSIONS_ALLOW_CUSTOM_ROLES=true
SYNQ_PERMISSIONS_ENABLE_AUDIT=true
SYNQ_PERMISSIONS_ENABLE_NOTIFICATIONS=true

# Configuration Synq - Keycloak (SSO)
SYNQ_KEYCLOAK_ENABLED=false
SYNQ_KEYCLOAK_SERVER_URL=https://sso.example.com
SYNQ_KEYCLOAK_REALM=synq
SYNQ_KEYCLOAK_CLIENT_ID=synq-web
SYNQ_KEYCLOAK_CLIENT_SECRET=your-client-secret
SYNQ_KEYCLOAK_AUTO_PROVISION=true
SYNQ_KEYCLOAK_SYNC_GROUPS=true
SYNQ_KEYCLOAK_SYNC_ROLES=true

# Configuration Synq - Jitsi
SYNQ_JITSI_ENHANCED_ENABLED=true
SYNQ_JITSI_SERVER_URL=https://meet.jit.si
SYNQ_JITSI_VOICE_ROOMS=true
SYNQ_JITSI_PERSISTENT_ROOMS=true
SYNQ_JITSI_AUTO_JOIN_VOICE=false
SYNQ_JITSI_ENCRYPTION_ENABLED=true

# Configuration Synq - Documents Collaboratifs
SYNQ_DOCS_ENABLED=true
SYNQ_DOCS_EDITOR_TYPE=etherpad
SYNQ_DOCS_SERVER_URL=http://localhost:9001
SYNQ_DOCS_API_KEY=your-etherpad-api-key
SYNQ_DOCS_AUTO_SAVE=true
SYNQ_DOCS_VERSIONING=true

# Configuration Synq - Analytics
SYNQ_ANALYTICS_ENABLED=true
SYNQ_ANALYTICS_DATA_COLLECTION=true
SYNQ_ANALYTICS_COLLECTION_INTERVAL=5
SYNQ_ANALYTICS_DATA_RETENTION=90
SYNQ_ANALYTICS_ADMIN_DASHBOARD=true
SYNQ_ANALYTICS_AUTO_REPORTS=true

# Configuration Synq - Sidebar
SYNQ_SIDEBAR_SIMPLIFIED_ENABLED=true
SYNQ_SIDEBAR_CATEGORIES_ENABLED=true
SYNQ_SIDEBAR_SEARCH_ENABLED=true

# Configuration Synq - Templates de Workspace
SYNQ_WORKSPACE_TEMPLATES_ENABLED=true
SYNQ_WORKSPACE_TEMPLATES_DEFAULT=startup

# Configuration Synq - Canaux en Lecture Seule
SYNQ_READONLY_CHANNELS_ENABLED=true
SYNQ_READONLY_CHANNELS_AUTO_ARCHIVE=true

# Configuration Synq - Workflows
SYNQ_WORKFLOWS_ENABLED=true
SYNQ_WORKFLOWS_SLASH_COMMANDS_ENABLED=true
SYNQ_WORKFLOWS_APPS_ENABLED=true

# Configuration Synq - Bridge
SYNQ_BRIDGE_ENABLED=true
SYNQ_BRIDGE_WEBHOOKS_ENABLED=true

# Configuration de sécurité
SYNQ_SECURITY_ENCRYPTION_ENABLED=true
SYNQ_SECURITY_AUDIT_LOGS_ENABLED=true
SYNQ_SECURITY_RATE_LIMITING_ENABLED=true

# Configuration de performance
SYNQ_PERFORMANCE_CACHING_ENABLED=true
SYNQ_PERFORMANCE_CDN_ENABLED=false
SYNQ_PERFORMANCE_COMPRESSION_ENABLED=true

# Configuration de monitoring
SYNQ_MONITORING_HEALTH_CHECKS_ENABLED=true
SYNQ_MONITORING_METRICS_ENABLED=true
SYNQ_MONITORING_ALERTS_ENABLED=true

# Configuration de backup
SYNQ_BACKUP_ENABLED=true
SYNQ_BACKUP_FREQUENCY=daily
SYNQ_BACKUP_RETENTION=30

# Configuration de logs
SYNQ_LOGS_LEVEL=info
SYNQ_LOGS_FORMAT=json
SYNQ_LOGS_ROTATION_ENABLED=true

# Configuration de développement
NODE_ENV=development
DEBUG=synq:*
SYNQ_DEV_MODE=true
SYNQ_DEV_HOT_RELOAD=true

# Configuration de production (décommentez pour la production)
# NODE_ENV=production
# SYNQ_DEV_MODE=false
# SYNQ_DEV_HOT_RELOAD=false
# SYNQ_SECURITY_STRICT_MODE=true
