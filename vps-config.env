# Configuration VPS pour Synq Chat + Synq.Team Auto-Publication

# Variables d'environnement pour l'auto-publication
SYNQ_VERSION=latest
SYNQ_CHAT_URL=http://localhost:3000
SYNQ_TEAM_URL=https://synq.team

# Configuration Docker
DOCKER_REGISTRY=registry.synq.com
DOCKER_USERNAME=synq
DOCKER_PASSWORD=your_password

# Configuration VPS
VPS_HOST=your-vps-host.com
VPS_USER=synq
VPS_DEPLOY_PATH=/opt/synq-chat

# Configuration Synq.Team
SYNQ_TEAM_REPO=MisterSandFR/Synq.Team
SYNQ_TEAM_DEPLOY_URL=https://synq.team

# Configuration des fonctionnalités vocales
SYNQ_NATIVE_VOICE_ENABLED=true
SYNQ_VOICE_PERSISTENT_ROOMS=true
SYNQ_VOICE_MAX_PARTICIPANTS=50
SYNQ_VOICE_SCREEN_SHARE_ENABLED=true
SYNQ_VOICE_CHAT_ENABLED=true
SYNQ_VOICE_ENCRYPTION_ENABLED=true
SYNQ_VOICE_MODERATION_ENABLED=true

# Configuration WebRTC
WEBRTC_ENABLED=true
WEBRTC_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_ENABLE_DIRECT=true
WEBRTC_ENABLE_PRIVATE=true
WEBRTC_ENABLE_CHANNEL=true
