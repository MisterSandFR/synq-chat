{
	"name": "synq-chat",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"deploy": "vite build && wrangler deploy",
		"typecheck": "wrangler types && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@fontsource-variable/onest": "^5.3.1",
		"hono": "^4.13.14",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@cloudflare/vitest-plugin": "^1.4.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.153.0"
	}
}
