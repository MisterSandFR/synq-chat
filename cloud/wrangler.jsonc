{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "synq-chat",
	"account_id": "eb78173c28099c9a619c22919e7dc9d7",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": { "enabled": true },
	"vars": {
		"RECUBE_ISSUER": "https://recube.gg",
		"RECUBE_CLIENT_ID": "f212ca84-4539-4842-9da7-f58b9b2d394b",
		"REALTIME_APP_ID": "8da7b4df0958febdfb5af2d7f19b4238",
		"TURN_KEY_ID": "1b4bddf025d9f7bffad55b8076c286d7"
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/assets/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "WORKSPACE", "class_name": "Workspace" },
			{ "name": "MAILBOX", "class_name": "Mailbox" },
			{ "name": "USER_HUB", "class_name": "UserHub" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Workspace"] },
		{ "tag": "v2", "new_sqlite_classes": ["Mailbox"] },
		{ "tag": "v3", "new_sqlite_classes": ["UserHub"] }
	],
	"d1_databases": [{ "binding": "DB", "database_name": "synq-chat", "database_id": "7a9814e6-ec0c-4fec-b527-196452e11206", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "synq-chat-files" }],
	"ai": { "binding": "AI" },
	"triggers": { "crons": ["* * * * *"] },
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
	]
}
