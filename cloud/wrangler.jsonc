{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "synq-chat",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": { "enabled": true },
	"vars": {
		"RECUBE_ISSUER": "https://recube.gg",
		"RECUBE_CLIENT_ID": "f212ca84-4539-4842-9da7-f58b9b2d394b"
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
	"d1_databases": [{ "binding": "DB", "database_name": "synq-chat", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "synq-chat-files" }],
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
	]
}
